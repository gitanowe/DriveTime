@startuml
title DriveTime — Основные бизнес-процессы (Flowcharts)
skinparam backgroundColor #ffffff
skinparam activity {
  BackgroundColor #f9f9f9
  BorderColor #333
  FontSize 13
}
skinparam shadowing false

partition "Клиент: создание заявки" {
  start
  :Запуск программы;
  :Авторизация клиента;
  :Выбор пункта меню\n"Оформить заявку";
  :Просмотр списка доступных автомобилей;

  :Выбор автомобиля;
  :Ввод данных заявки\n(дата начала, время, срок аренды);

  if (Автомобиль доступен?) then (да)
    :Симуляция оплаты\n(QR-код или СБП);
    :Создание новой заявки;
    :Сохранение заявки в базе данных;
    :Вывод сообщения "Заявка отправлена на рассмотрение";
  else (нет)
    :Вывод сообщения "Выбранный автомобиль недоступен";
  endif

  stop
}

partition "Администратор: обработка заявки" {
  start
  :Вход администратора в систему;
  :Просмотр списка поступивших заявок;
  :Выбор конкретной заявки;

  if (Автомобиль доступен к дате аренды?) then (да)
    :Подтверждение заявки;
    :Изменение статуса заявки → "Подтверждена";
    :Уведомление клиента о подтверждении;
  else (нет)
    :Отклонение заявки;
    :Изменение статуса заявки → "Отклонена";
    :Уведомление клиента о причине отказа;
  endif

  stop
}

partition "Процесс возврата автомобиля" {
  start
  :Проверка состояния автомобиля;

  if (Автомобиль без повреждений?) then (да)
    :Изменение статуса заявки → "Завершена";
    :Обновление статуса автомобиля → "Свободен";
    :Фиксация даты возврата;
  else (нет)
    :Создание акта повреждения;
    :Расчёт штрафа и уведомление клиента\n(с опцией оплаты штрафа);
    :Изменение статуса автомобиля → "На осмотре";
  endif

  stop
}

@enduml