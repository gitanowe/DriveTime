@startuml

!theme plain
hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor Black
  FontName "Consolas"
}

entity "Car" as Car {
  *car_id : INTEGER <<PK>>
  --
  brand : TEXT
  model : TEXT
  year : INTEGER
  price_per_day : REAL
  is_busy : INTEGER <<default 0>>
}

entity "Customer" as Customer {
  *customer_id : INTEGER <<PK>>
  --
  username : TEXT
  password : TEXT
  full_name : TEXT
  phone : TEXT
  email : TEXT
  passport : TEXT
  driver_license : TEXT
}

entity "Admin" as Admin {
  *admin_id : INTEGER <<PK>>
  --
  username : TEXT
  password : TEXT
}

entity "Rental" as Rental {
  *rental_id : INTEGER <<PK>>
  --
  car_id : INTEGER <<FK>>
  customer_id : INTEGER <<FK>>
  admin_id : INTEGER <<FK>>
  start_date : DATE
  end_date : DATE
  status : TEXT
  total_price : REAL
}

entity "Payment" as Payment {
  *payment_id : INTEGER <<PK>>
  --
  rental_id : INTEGER <<FK>>
  amount : REAL
  payment_date : DATE
}

entity "Maintenance" as Maintenance {
  *id : INTEGER <<PK>>
  --
  car_id : INTEGER <<FK>>
  service_date : DATE
  description : TEXT
  cost : REAL
  rental_id : INTEGER <<FK>>
  is_paid : INTEGER <<default 0>>
}

' СВЯЗИ (1:N и M:N)

' 1:N — Клиент может иметь несколько аренд
Customer ||--o{ Rental

' 1:N — Машина может участвовать в нескольких арендах
Car ||--o{ Rental

' 1:N — Администратор может подтверждать несколько аренд
Admin ||--o{ Rental

' 1:N — Каждая аренда может иметь несколько платежей (обновлено для consistency с кодом, где платежи могут быть множественными, e.g. штрафы)
Rental ||--o{ Payment

' 1:N — Одна машина может иметь несколько записей обслуживания
Car ||--o{ Maintenance

' 1:N — Аренда может иметь несколько записей обслуживания (штрафы/повреждения)
Rental ||--o{ Maintenance

@enduml